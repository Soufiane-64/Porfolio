{
    "compilerOptions": {
        "checkJs": true,
        "jsx": "react-jsx",
        "baseUrl": "src",
        "resolveJsonModule": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": [
            "es2020",
            "dom",
            "dom.iterable"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "build",
        "dist"
    ]
}